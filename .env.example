# Resend API Key (para envio de e-mails)
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Firebase Service Account (JSON completo do Admin SDK)
# Obtenha em: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# CRON Secret (para proteger a rota de notificações)
# Gere uma string aleatória segura
CRON_SECRET=your_random_secret_here

# URL da aplicação (para links nos e-mails)
VITE_APP_URL=https://ibit.app
