{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Kanban platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "A Kanban project for the STEM racing team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "photoURL": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "members", "createdAt"]
    },
    "Board": {
      "title": "Board",
      "description": "A column/board within a project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["projectId", "name", "order"]
    },
    "Task": {
      "title": "Task",
      "description": "A task card within a board",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "boardId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "order": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" }
      },
      "required": ["projectId", "boardId", "title", "order", "createdAt", "authorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects created by users"
    },
    "/boards/{boardId}": {
      "schema": { "$ref": "#/entities/Board" },
      "description": "Boards/columns for a project"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks within a project"
    }
  }
}
